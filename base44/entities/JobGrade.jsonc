{
  "name": "JobGrade",
  "type": "object",
  "properties": {
    "grade_code": {
      "type": "string"
    },
    "grade_name": {
      "type": "string"
    },
    "minimum_salary": {
      "type": "number"
    },
    "maximum_salary": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "grade_code",
    "grade_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}