{
  "name": "Suggestion",
  "type": "object",
  "properties": {
    "employee_email": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "anonymous": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "under_review",
        "implemented",
        "rejected"
      ],
      "default": "open"
    },
    "response": {
      "type": "string"
    }
  },
  "required": [
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}