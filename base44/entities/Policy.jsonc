{
  "name": "Policy",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Policy",
        "SOP",
        "Template",
        "Contract",
        "Letter"
      ],
      "default": "Policy"
    },
    "content": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "audience": {
      "type": "string",
      "enum": [
        "all",
        "branch",
        "department"
      ],
      "default": "all"
    },
    "department_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}