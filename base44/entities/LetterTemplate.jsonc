{
  "name": "LetterTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "offer",
        "appointment",
        "experience",
        "salary",
        "promotion",
        "transfer",
        "warning",
        "other"
      ],
      "default": "offer"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "description": "Template with {{placeholders}}"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "type",
    "body"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}