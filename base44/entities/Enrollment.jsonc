{
  "name": "Enrollment",
  "type": "object",
  "properties": {
    "employee_email": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "enrolled",
        "completed",
        "cancelled"
      ],
      "default": "enrolled"
    },
    "certificate_url": {
      "type": "string"
    }
  },
  "required": [
    "employee_email",
    "session_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.employee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}