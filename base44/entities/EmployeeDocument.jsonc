{
  "name": "EmployeeDocument",
  "type": "object",
  "properties": {
    "employee_email": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "ID Proof",
        "Address Proof",
        "Education Certificate",
        "Offer Letter",
        "Experience Letter",
        "Contract",
        "Other"
      ]
    },
    "name": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "uploaded_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "mandatory": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "expired"
      ],
      "default": "pending"
    }
  },
  "required": [
    "document_type",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.employee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}