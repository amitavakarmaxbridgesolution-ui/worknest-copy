{
  "name": "Candidate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "Referral",
        "Agency",
        "Job Portal",
        "Walk-in",
        "Other"
      ]
    },
    "current_status": {
      "type": "string",
      "enum": [
        "applied",
        "shortlisted",
        "interview",
        "selected",
        "offer",
        "hired",
        "rejected"
      ],
      "default": "applied"
    },
    "resume_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}