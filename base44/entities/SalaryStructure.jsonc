{
  "name": "SalaryStructure",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "base_salary": {
      "type": "number"
    },
    "components": {
      "type": "string",
      "description": "JSON array of {name, code, type, calc_type, value}"
    },
    "employer_pf_type": {
      "type": "string",
      "enum": [
        "fixed",
        "percentage"
      ],
      "default": "fixed"
    },
    "employer_pf_value": {
      "type": "number",
      "default": 0
    },
    "employer_esi_type": {
      "type": "string",
      "enum": [
        "fixed",
        "percentage"
      ],
      "default": "fixed"
    },
    "employer_esi_value": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}