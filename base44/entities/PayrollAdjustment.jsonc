{
  "name": "PayrollAdjustment",
  "type": "object",
  "properties": {
    "payroll_run_id": {
      "type": "string"
    },
    "employee_email": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "correction",
        "adjustment"
      ],
      "default": "correction"
    },
    "component": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "applied",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "employee_email",
    "component",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.employee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}