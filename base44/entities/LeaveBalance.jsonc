{
  "name": "LeaveBalance",
  "type": "object",
  "properties": {
    "employee_email": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "leave_type_id": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "used": {
      "type": "number",
      "default": 0
    },
    "carried": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "employee_email",
    "leave_type_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.employee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}