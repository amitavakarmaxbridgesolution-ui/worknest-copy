server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # --- Base44 backend reverse proxy ---------------------------------------
    # The app's frontend calls relative /api/... paths (see src/api/base44Client.js,
    # which sets serverUrl: '' on purpose — the same client code runs in local dev,
    # where @base44/vite-plugin proxies /api to VITE_BASE44_APP_BASE_URL, and in
    # production, where THIS block must do the same job). Without this proxy,
    # every auth/entity/function call (login, signup, list, create, ...) dead-ends
    # at this static file server and comes back as 405 Method Not Allowed —
    # that's the bug this block fixes.
    location /api/ {
        proxy_pass ${BASE44_BACKEND_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host ${BASE44_BACKEND_HOST};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
    }

    # Realtime/socket mount used by the SDK's analytics + rooms modules.
    location /ws-user-apps/ {
        proxy_pass ${BASE44_BACKEND_URL}/ws-user-apps/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host ${BASE44_BACKEND_HOST};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
    }

    # SPA fallback: let react-router own client-side routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Fingerprinted bundles — cache hard
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
